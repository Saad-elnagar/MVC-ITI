
@model List<Product>

@{
    ViewData["Title"] = "All Products";
}

<h2>Products List</h2>

<table class="table table-bordered table-striped mt-3">
    <thead class="table-dark">
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Price</th>
        <th>Image</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.Price.ToString("C")</td>
            <td>
                <img src="~/images/@item.Image" alt="@item.Name" style="width: 50px; height: 50px; object-fit: cover;" />
            </td>
            <td>
                <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Details</a>
            </td>
        </tr>
    }
    </tbody>
</table>
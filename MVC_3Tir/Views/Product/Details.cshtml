@model Product

@{
    ViewData["Title"] = "Product Details";
}

<h2>Product Details</h2>

<div class="card mt-3" style="width: 18rem;">
    <img src="~/images/@Model.Image" class="card-img-top" alt="@Model.Name" style="height: 200px; object-fit: cover;">
    <div class="card-body">
        <h5 class="card-title">@Model.Name</h5>
        <p class="card-text"><strong>ID:</strong> @Model.Id</p>
        <p class="card-text"><strong>Price:</strong> @Model.Price.ToString("C")</p>
        <a asp-controller="Product" asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>